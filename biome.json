{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/cdk.out",
      "!**/routeTree.gen.ts",
      "!docs",
      "!tools",
      "!**/*.gen.ts",
      "!services/api/openapi.json",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml",
      "!evals",
      "!**/*.html",
      "!**/*.css",
      "!packages/py",
      "!services",
      "!tests",
      "!deploy"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "Select", "Textarea"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
