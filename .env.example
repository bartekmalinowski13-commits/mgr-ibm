# Copy to deploy/compose/.env for the local stack. Local-only values - never real secrets.
POSTGRES_PASSWORD=local-admin
BOMAGENT_MIGRATOR_PASSWORD=local-migrator
BOMAGENT_APP_PASSWORD=local-app
BOMAGENT_PLATFORM_PASSWORD=local-platform
LITELLM_MASTER_KEY=sk-local-only
CLICKHOUSE_PASSWORD=local-clickhouse
VALKEY_PASSWORD=local-valkey
# Tests: superuser URL of a Postgres+pgvector to use instead of Testcontainers
# BOMAGENT_TEST_DATABASE_URL=postgresql+psycopg://postgres:local-admin@localhost:5432/postgres
