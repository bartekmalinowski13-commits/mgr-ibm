# Copy to deploy/compose/.env for the local stack. Local-only values - never real secrets.
POSTGRES_PASSWORD=local-admin
BOMAGENT_MIGRATOR_PASSWORD=local-migrator
BOMAGENT_APP_PASSWORD=local-app
BOMAGENT_PLATFORM_PASSWORD=local-platform
LITELLM_MASTER_KEY=sk-local-only
CLICKHOUSE_PASSWORD=local-clickhouse
VALKEY_PASSWORD=local-valkey
# Tests: superuser URL of a Postgres+pgvector to use instead of Testcontainers
# BOMAGENT_TEST_DATABASE_URL=postgresql+psycopg://postgres:local-admin@localhost:5432/postgres

# Audit chain anchors (daily head of each tenant's audit chain in write-once storage, ADR-0011).
# Set one: a directory (write-once volume / off-platform copy) or an S3 bucket with Object Lock.
# BOMAGENT_AUDIT_ANCHOR_DIR=/var/lib/bomagent/audit-anchors
# BOMAGENT_AUDIT_ANCHOR_BUCKET=bomagent-audit-anchors
# BOMAGENT_AUDIT_ANCHOR_ENDPOINT_URL=   # S3-compatible stores only (Supabase Storage)
# Client address for audit and per-IP limits: the trusted edge header (never X-Forwarded-For)
# BOMAGENT_CLIENT_IP_HEADER=Fly-Client-IP
# Invitation e-mail (UX-02): off unless a host is set. EU relay = operator's choice; no default.
# BOMAGENT_SMTP_HOST=
# BOMAGENT_SMTP_PORT=587
# BOMAGENT_SMTP_USERNAME=
# BOMAGENT_SMTP_PASSWORD=
# BOMAGENT_SMTP_SENDER=noreply@example.eu
# BOMAGENT_INVITE_BASE_URL=https://app.example.eu
