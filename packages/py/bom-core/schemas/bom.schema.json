{
  "$defs": {
    "BomItem": {
      "additionalProperties": false,
      "description": "One BOM line (grouped identical parts).",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "dnp": {
          "default": false,
          "title": "Dnp",
          "type": "boolean"
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Fields",
          "type": "object"
        },
        "footprint": {
          "default": "",
          "title": "Footprint",
          "type": "string"
        },
        "kind": {
          "default": "other",
          "title": "Kind",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "manufacturer": {
          "default": "",
          "title": "Manufacturer",
          "type": "string"
        },
        "mpn": {
          "default": "",
          "title": "Mpn",
          "type": "string"
        },
        "package": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/Provenance"
          },
          "description": "Who decided each field: keys are field names or 'item' for the line.",
          "title": "Provenance",
          "type": "object"
        },
        "quantity": {
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "refdes": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z_#]+\\d+[A-Za-z]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Refdes",
          "type": "array"
        },
        "value": {
          "default": "",
          "title": "Value",
          "type": "string"
        },
        "value_normalized": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Normalized"
        }
      },
      "required": [
        "line",
        "refdes",
        "quantity"
      ],
      "title": "BomItem",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "refdes": {
          "items": {
            "type": "string"
          },
          "title": "Refdes",
          "type": "array"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_pack": {
          "default": "",
          "title": "Rule Pack",
          "type": "string"
        },
        "rule_pack_version": {
          "default": "",
          "title": "Rule Pack Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "rule_id",
        "severity",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "KbCitation": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "quote": {
          "default": "",
          "maxLength": 500,
          "title": "Quote",
          "type": "string"
        },
        "scope": {
          "default": "global",
          "enum": [
            "global",
            "tenant"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "chunk_id"
      ],
      "title": "KbCitation",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/KbCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "parser": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser"
        },
        "prompt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Id"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "rationale": {
          "default": "",
          "maxLength": 2000,
          "title": "Rationale",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "rule_pack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Pack"
        },
        "rule_pack_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Pack Version"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceKind": {
      "enum": [
        "parser",
        "rule",
        "agent",
        "user"
      ],
      "title": "ProvenanceKind",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "review",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Cost accounting of producing a BOM (thesis metric PB3).",
      "properties": {
        "cached_input_tokens": {
          "default": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "cost_eur": {
          "default": 0.0,
          "title": "Cost Eur",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "wall_time_s": {
          "default": 0.0,
          "title": "Wall Time S",
          "type": "number"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "$id": "https://bomagent.eu/schemas/bom/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "design_name": {
      "title": "Design Name",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/BomItem"
      },
      "title": "Items",
      "type": "array"
    },
    "kb_snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kb Snapshot Id"
    },
    "rule_pack": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Pack"
    },
    "rule_pack_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Pack Version"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "variant": {
      "default": "",
      "title": "Variant",
      "type": "string"
    }
  },
  "required": [
    "design_name",
    "items"
  ],
  "title": "BomVersion",
  "type": "object"
}
